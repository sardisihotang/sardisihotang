<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 400" width="1280" height="400" role="img" aria-label="Sardianto Sihotang - Data Analyst | Web Developer">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#030816"/>
      <stop offset="0.55" stop-color="#0a1c47"/>
      <stop offset="1" stop-color="#061230"/>
    </linearGradient>
    <radialGradient id="halo" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#22d3ee" stop-opacity="0.28"/>
      <stop offset="0.6" stop-color="#1d4ed8" stop-opacity="0.10"/>
      <stop offset="1" stop-color="#1d4ed8" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="#3b82f6" stroke-opacity="0.12" stroke-width="1"/>
    </pattern>
    <linearGradient id="head" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f1f6ff"/>
      <stop offset="1" stop-color="#aebfe0"/>
    </linearGradient>
    <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#22345f"/>
      <stop offset="1" stop-color="#0d1836"/>
    </linearGradient>
    <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#22d3ee" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#22d3ee" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="rule" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#22d3ee"/>
      <stop offset="1" stop-color="#22d3ee" stop-opacity="0"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.5" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="soft" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1280" height="400" fill="url(#bg)"/>
  <rect width="1280" height="400" fill="url(#grid)"/>
  <ellipse cx="930" cy="230" rx="380" ry="230" fill="url(#halo)"/>

  <!-- Text block -->
  <g font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif">
    <text x="72" y="138" font-size="13" font-weight="600" letter-spacing="5" fill="#22d3ee">PORTFOLIO</text>
    <text x="72" y="196" font-size="54" font-weight="700" letter-spacing="0.5" fill="#ffffff">Sardianto <tspan fill="#67e8f9">Sihotang</tspan></text>
    <text x="74" y="240" font-size="22" font-weight="400" letter-spacing="2.5" fill="#93c5fd">Data Analyst  |  Web Developer</text>
    <rect x="74" y="266" width="160" height="3" rx="1.5" fill="url(#rule)">
      <animate attributeName="width" values="60;160;60" dur="6s" repeatCount="indefinite"/>
    </rect>
  </g>

  <!-- Floating data particles -->
  <g fill="#67e8f9" filter="url(#glow)">
    <circle cx="690" r="1.6"><animate attributeName="cy" values="310;110" dur="7s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.8;0" dur="7s" repeatCount="indefinite"/></circle>
    <circle cx="760" r="1.2"><animate attributeName="cy" values="320;100" dur="9s" begin="1s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.7;0" dur="9s" begin="1s" repeatCount="indefinite"/></circle>
    <circle cx="830" r="1.8"><animate attributeName="cy" values="300;90" dur="8s" begin="2s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.8;0" dur="8s" begin="2s" repeatCount="indefinite"/></circle>
    <circle cx="900" r="1.3"><animate attributeName="cy" values="140;60" dur="6s" begin="0.5s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.7;0" dur="6s" begin="0.5s" repeatCount="indefinite"/></circle>
    <circle cx="960" r="1.5"><animate attributeName="cy" values="130;55" dur="7s" begin="3s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.8;0" dur="7s" begin="3s" repeatCount="indefinite"/></circle>
    <circle cx="1050" r="1.7"><animate attributeName="cy" values="300;100" dur="9s" begin="1.5s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.8;0" dur="9s" begin="1.5s" repeatCount="indefinite"/></circle>
    <circle cx="1130" r="1.2"><animate attributeName="cy" values="310;90" dur="8s" begin="4s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.7;0" dur="8s" begin="4s" repeatCount="indefinite"/></circle>
    <circle cx="1200" r="1.6"><animate attributeName="cy" values="320;120" dur="10s" begin="2.5s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.8;0" dur="10s" begin="2.5s" repeatCount="indefinite"/></circle>
    <circle cx="1235" r="1.3"><animate attributeName="cy" values="300;130" dur="7s" begin="5s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.6;0" dur="7s" begin="5s" repeatCount="indefinite"/></circle>
  </g>

  <!-- Left monitor: code -->
  <g>
    <rect x="752" y="280" width="16" height="50" fill="#13234d"/>
    <rect x="660" y="150" width="200" height="130" rx="8" fill="#0b1633" stroke="#22d3ee" stroke-opacity="0.55"/>
    <rect x="668" y="158" width="184" height="114" rx="4" fill="#060e24"/>
    <rect x="660" y="150" width="200" height="130" rx="8" fill="none" stroke="#22d3ee" stroke-opacity="0.25" filter="url(#soft)"/>
    <circle cx="678" cy="168" r="2.5" fill="#22d3ee" opacity="0.8"/>
    <circle cx="688" cy="168" r="2.5" fill="#60a5fa" opacity="0.7"/>
    <circle cx="698" cy="168" r="2.5" fill="#e2e8f0" opacity="0.6"/>
    <g>
      <rect x="680" y="184" width="40" height="5" rx="2.5" fill="#22d3ee"/>
      <rect x="726" y="184" width="64" height="5" rx="2.5" fill="#e2e8f0" opacity="0.8"/>
      <rect x="692" y="198" width="70" height="5" rx="2.5" fill="#60a5fa"/>
      <rect x="692" y="212" width="48" height="5" rx="2.5" fill="#e2e8f0" opacity="0.7"/>
      <rect x="746" y="212" width="52" height="5" rx="2.5" fill="#22d3ee" opacity="0.9"/>
      <rect x="692" y="226" width="92" height="5" rx="2.5" fill="#60a5fa" opacity="0.8"/>
      <rect x="680" y="240" width="32" height="5" rx="2.5" fill="#22d3ee"/>
      <rect x="718" y="240" width="56" height="5" rx="2.5" fill="#e2e8f0" opacity="0.7"/>
      <animate attributeName="opacity" values="0.75;1;0.75" dur="4s" repeatCount="indefinite"/>
    </g>
    <rect x="780" y="240" width="5" height="8" fill="#67e8f9"><animate attributeName="opacity" values="1;0;1" dur="1.1s" repeatCount="indefinite"/></rect>
  </g>

  <!-- Right monitor: dashboard -->
  <g>
    <rect x="1102" y="280" width="16" height="50" fill="#13234d"/>
    <rect x="1000" y="140" width="220" height="140" rx="8" fill="#0b1633" stroke="#22d3ee" stroke-opacity="0.55"/>
    <rect x="1008" y="148" width="204" height="124" rx="4" fill="#060e24"/>
    <rect x="1000" y="140" width="220" height="140" rx="8" fill="none" stroke="#22d3ee" stroke-opacity="0.25" filter="url(#soft)"/>
    <!-- KPI tiles -->
    <rect x="1018" y="158" width="52" height="22" rx="4" fill="#0f2557"/>
    <rect x="1076" y="158" width="52" height="22" rx="4" fill="#0f2557"/>
    <rect x="1134" y="158" width="68" height="22" rx="4" fill="#0f2557"/>
    <rect x="1024" y="164" width="22" height="3" rx="1.5" fill="#93c5fd"/>
    <rect x="1024" y="171" width="34" height="5" rx="2.5" fill="#ffffff"/>
    <rect x="1082" y="164" width="22" height="3" rx="1.5" fill="#93c5fd"/>
    <rect x="1082" y="171" width="30" height="5" rx="2.5" fill="#22d3ee"/>
    <rect x="1140" y="164" width="22" height="3" rx="1.5" fill="#93c5fd"/>
    <rect x="1140" y="171" width="40" height="5" rx="2.5" fill="#ffffff"/>
    <!-- Line chart -->
    <path d="M1020 236 C1045 222 1062 244 1090 214 S1140 206 1160 190 S1190 186 1202 178 L1202 250 L1020 250 Z" fill="url(#area)"/>
    <path d="M1020 236 C1045 222 1062 244 1090 214 S1140 206 1160 190 S1190 186 1202 178" fill="none" stroke="#67e8f9" stroke-width="2" stroke-linecap="round" stroke-dasharray="260" filter="url(#glow)">
      <animate attributeName="stroke-dashoffset" values="260;0;0;260" keyTimes="0;0.5;0.85;1" dur="6s" repeatCount="indefinite"/>
    </path>
    <circle r="3" fill="#ffffff" filter="url(#glow)">
      <animateMotion dur="6s" repeatCount="indefinite" keyPoints="0;1;1;0" keyTimes="0;0.5;0.85;1" calcMode="linear" path="M1020 236 C1045 222 1062 244 1090 214 S1140 206 1160 190 S1190 186 1202 178"/>
    </circle>
    <!-- Bars -->
    <g fill="#3b82f6" opacity="0.9">
      <rect x="1022" y="258" width="10" height="8" rx="2"><animate attributeName="height" values="8;16;8" dur="3s" repeatCount="indefinite"/><animate attributeName="y" values="258;250;258" dur="3s" repeatCount="indefinite"/></rect>
      <rect x="1040" y="256" width="10" height="10" rx="2"><animate attributeName="height" values="10;6;10" dur="3.4s" repeatCount="indefinite"/><animate attributeName="y" values="256;260;256" dur="3.4s" repeatCount="indefinite"/></rect>
      <rect x="1058" y="252" width="10" height="14" rx="2" fill="#22d3ee"><animate attributeName="height" values="14;9;14" dur="2.8s" repeatCount="indefinite"/><animate attributeName="y" values="252;257;252" dur="2.8s" repeatCount="indefinite"/></rect>
      <rect x="1076" y="255" width="10" height="11" rx="2"><animate attributeName="height" values="11;17;11" dur="3.6s" repeatCount="indefinite"/><animate attributeName="y" values="255;249;255" dur="3.6s" repeatCount="indefinite"/></rect>
    </g>
    <circle cx="1170" cy="258" r="8" fill="none" stroke="#1e3a8a" stroke-width="4"/>
    <circle cx="1170" cy="258" r="8" fill="none" stroke="#22d3ee" stroke-width="4" stroke-dasharray="32 50" transform="rotate(-90 1170 258)" stroke-linecap="round"/>
    <rect x="1186" y="254" width="16" height="3" rx="1.5" fill="#93c5fd"/>
    <rect x="1186" y="261" width="10" height="3" rx="1.5" fill="#e2e8f0" opacity="0.7"/>
  </g>

  <!-- Keyboard -->
  <rect x="884" y="323" width="92" height="7" rx="3" fill="#1b2a4e" stroke="#22d3ee" stroke-opacity="0.4"/>

  <!-- Robot -->
  <g>
    <!-- Body -->
    <rect x="890" y="218" width="80" height="112" rx="24" fill="url(#body)" stroke="#3b82f6" stroke-opacity="0.5"/>
    <rect x="920" y="246" width="20" height="4" rx="2" fill="#22d3ee" filter="url(#glow)">
      <animate attributeName="opacity" values="0.4;1;0.4" dur="3s" repeatCount="indefinite"/>
    </rect>
    <rect x="926" y="256" width="8" height="3" rx="1.5" fill="#93c5fd" opacity="0.6"/>
    <!-- Neck -->
    <rect x="922" y="204" width="16" height="16" rx="4" fill="#8da2c8"/>
    <!-- Arms -->
    <path d="M894 240 Q868 290 903 321" fill="none" stroke="#1e3a6e" stroke-width="11" stroke-linecap="round"/>
    <path d="M966 240 Q992 290 957 321" fill="none" stroke="#1e3a6e" stroke-width="11" stroke-linecap="round"/>
    <path d="M894 240 Q868 290 903 321" fill="none" stroke="#3b82f6" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M966 240 Q992 290 957 321" fill="none" stroke="#3b82f6" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round"/>
    <!-- Hands (typing) -->
    <circle cx="905" cy="321" r="5" fill="#e2f4ff">
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -2;0 0" dur="0.7s" repeatCount="indefinite"/>
    </circle>
    <circle cx="955" cy="321" r="5" fill="#e2f4ff">
      <animateTransform attributeName="transform" type="translate" values="0 -2;0 0;0 -2" dur="0.7s" repeatCount="indefinite"/>
    </circle>
    <!-- Antenna -->
    <line x1="930" y1="150" x2="930" y2="138" stroke="#8da2c8" stroke-width="2"/>
    <circle cx="930" cy="135" r="3.2" fill="#22d3ee" filter="url(#glow)">
      <animate attributeName="opacity" values="1;0.3;1" dur="2.4s" repeatCount="indefinite"/>
    </circle>
    <!-- Head -->
    <rect x="882" y="173" width="7" height="16" rx="3" fill="#8da2c8"/>
    <rect x="971" y="173" width="7" height="16" rx="3" fill="#8da2c8"/>
    <rect x="888" y="150" width="84" height="60" rx="24" fill="url(#head)"/>
    <rect x="898" y="164" width="64" height="32" rx="16" fill="#050c20"/>
    <rect x="898" y="164" width="64" height="32" rx="16" fill="none" stroke="#22d3ee" stroke-opacity="0.45"/>
    <!-- Eyes -->
    <rect x="910" y="174" width="12" height="12" rx="6" fill="#67e8f9" filter="url(#glow)">
      <animate attributeName="height" values="12;12;2;12;12" keyTimes="0;0.9;0.94;0.98;1" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="y" values="174;174;179;174;174" keyTimes="0;0.9;0.94;0.98;1" dur="5s" repeatCount="indefinite"/>
    </rect>
    <rect x="938" y="174" width="12" height="12" rx="6" fill="#67e8f9" filter="url(#glow)">
      <animate attributeName="height" values="12;12;2;12;12" keyTimes="0;0.9;0.94;0.98;1" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="y" values="174;174;179;174;174" keyTimes="0;0.9;0.94;0.98;1" dur="5s" repeatCount="indefinite"/>
    </rect>
  </g>

  <!-- Desk (in front of the robot's torso) -->
  <rect x="630" y="330" width="620" height="8" rx="4" fill="#0f2a5c" stroke="#22d3ee" stroke-opacity="0.5"/>
  <rect x="630" y="338" width="620" height="22" fill="#08142f" opacity="0.8"/>
  <rect x="700" y="338" width="6" height="62" fill="#0b1a3d"/>
  <rect x="1170" y="338" width="6" height="62" fill="#0b1a3d"/>
  <rect x="630" y="329" width="620" height="2" fill="#22d3ee" opacity="0.5" filter="url(#glow)">
    <animate attributeName="opacity" values="0.3;0.7;0.3" dur="5s" repeatCount="indefinite"/>
  </rect>
</svg>
